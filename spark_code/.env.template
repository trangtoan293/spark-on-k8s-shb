# ============================================================================
# Spark ETL Pipeline - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git (already in .gitignore)

# ============================================================================
# Oracle Database Configuration
# ============================================================================
ORACLE_HOST=oracle.example.com
ORACLE_PORT=1521
ORACLE_SERVICE=ORCL
ORACLE_USERNAME=etl_user
ORACLE_PASSWORD=change_me

# ============================================================================
# MySQL Database Configuration
# ============================================================================
MYSQL_HOST=mysql.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=production
MYSQL_USERNAME=etl_user
MYSQL_PASSWORD=change_me

# ============================================================================
# MS SQL Server Database Configuration
# ============================================================================
MSSQL_HOST=mssql.example.com
MSSQL_PORT=1433
MSSQL_DATABASE=production
MSSQL_USERNAME=etl_user
MSSQL_PASSWORD=change_me

# ============================================================================
# Control Tables Configuration
# ============================================================================
# Database for checkpoint and job log tables
CONTROL_DB=etladmin

# Table names (without database prefix)
CHECKPOINT_TABLE=cdc_checkpoint
JOB_LOG_TABLE=job_run_logs

# ============================================================================
# Checkpoint Backend Configuration
# ============================================================================
# Backend type: "table" (Iceberg) or "json" (S3/MinIO)
CHECKPOINT_BACKEND=table

# Location for JSON checkpoint files (only used if CHECKPOINT_BACKEND=json)
CHECKPOINT_LOCATION=s3a://data/checkpoints

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Log format (Python logging format)
LOG_FORMAT=%(asctime)s [%(levelname)s] %(name)s - %(message)s

# ============================================================================
# AWS/MinIO Configuration (for S3 access)
# ============================================================================
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_ENDPOINT=http://minio.example.com:9000  # For MinIO

# ============================================================================
# Spark Configuration (optional overrides)
# ============================================================================
# SPARK_MASTER=spark://spark-master:7077
# SPARK_DRIVER_MEMORY=2g
# SPARK_EXECUTOR_MEMORY=4g
# SPARK_EXECUTOR_CORES=2
